{
  "manifest_version": 3,
  "name": "My Tools",
  "version": "1.0.0",
  "description": "Personal multi-tool extension",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.tiktokv.com/*",
    "*://*.bytecdn.cn/*",
    "*://www.tikwm.com/*",
    "*://api.cobalt.tools/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.ytimg.com/*",
    "*://chamcong.amira.vn/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content/tiktok-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*"],
      "js": ["content/youtube-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
