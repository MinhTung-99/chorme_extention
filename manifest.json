{
  "manifest_version": 3,
  "name": "My Tools",
  "version": "1.0.0",
  "description": "Personal multi-tool extension",
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://chamcong.amira.vn/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
